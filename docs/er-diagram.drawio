<mxfile host="app.diagrams.net" version="24.7.17"><diagram name="PayLink ER Model" id="paylink-er"><mxGraphModel dx="1250" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1250" pageHeight="900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="users" value="&lt;b&gt;USERS&lt;/b&gt;&lt;hr&gt;id : uuid [PK]&lt;br&gt;username : text [UNIQUE]&lt;br&gt;email : text [UNIQUE]&lt;br&gt;phone : text [UNIQUE, nullable]&lt;br&gt;full_name : text&lt;br&gt;password_hash : text (Argon2id)&lt;br&gt;created_at : timestamptz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F6FC;strokeColor=#A9BDDD;fontColor=#20384A;align=left;verticalAlign=top;spacing=16;fontSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="70" width="335" height="233" /></mxCell><mxCell id="account_holders" value="&lt;b&gt;ACCOUNT_HOLDERS&lt;/b&gt;&lt;hr&gt;user_id : uuid [PK, FK → users]&lt;br&gt;account_id : uuid [PK, FK → accounts]&lt;br&gt;joined_at : timestamptz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F6FC;strokeColor=#A9BDDD;fontColor=#20384A;align=left;verticalAlign=top;spacing=16;fontSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="80" width="335" height="137" /></mxCell><mxCell id="banks" value="&lt;b&gt;BANKS&lt;/b&gt;&lt;hr&gt;id : uuid [PK]&lt;br&gt;routing_number : text [UNIQUE]&lt;br&gt;name : text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F6FC;strokeColor=#A9BDDD;fontColor=#20384A;align=left;verticalAlign=top;spacing=16;fontSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="80" width="335" height="137" /></mxCell><mxCell id="bank_accounts" value="&lt;b&gt;BANK_ACCOUNTS&lt;/b&gt;&lt;hr&gt;id : uuid [PK]&lt;br&gt;bank_id : uuid [FK → banks]&lt;br&gt;account_number : text&lt;br&gt;account_type : checking | savings&lt;br&gt;label : text&lt;br&gt;balance_cents : bigint ≥ 0&lt;br&gt;opening_balance_cents : bigint ≥ 0&lt;br&gt;active : boolean&lt;br&gt;created_at : timestamptz&lt;br&gt;UNIQUE(bank_id, account_number)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F6FC;strokeColor=#A9BDDD;fontColor=#20384A;align=left;verticalAlign=top;spacing=16;fontSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="800" y="330" width="335" height="305" /></mxCell><mxCell id="transfers" value="&lt;b&gt;TRANSFERS&lt;/b&gt;&lt;hr&gt;id : uuid [PK]&lt;br&gt;initiated_by : uuid [FK → users]&lt;br&gt;source_account_id : uuid [FK → accounts]&lt;br&gt;destination_account_id : uuid [FK → accounts]&lt;br&gt;amount_cents : bigint &amp;gt; 0&lt;br&gt;memo : text (≤ 140)&lt;br&gt;idempotency_key : uuid&lt;br&gt;created_at : timestamptz&lt;br&gt;UNIQUE(initiated_by, idempotency_key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F6FC;strokeColor=#A9BDDD;fontColor=#20384A;align=left;verticalAlign=top;spacing=16;fontSize=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="250" y="390" width="335" height="281" /></mxCell><mxCell id="edge0" value="1 : 0..N · ownership" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;fontSize=11;fontColor=#486487;strokeColor=#7F99BC;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="users" target="account_holders"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge1" value="1 : 1..N · holders*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;fontSize=11;fontColor=#486487;strokeColor=#7F99BC;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bank_accounts" target="account_holders"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge2" value="1 : 0..N · bank" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;fontSize=11;fontColor=#486487;strokeColor=#7F99BC;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="banks" target="bank_accounts"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge3" value="1 : 0..N · initiator" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;fontSize=11;fontColor=#486487;strokeColor=#7F99BC;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="users" target="transfers"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge4" value="1 : 0..N · source" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;fontSize=11;fontColor=#486487;strokeColor=#7F99BC;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bank_accounts" target="transfers"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge5" value="1 : 0..N · destination" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=ERmany;startArrow=ERone;fontSize=11;fontColor=#486487;strokeColor=#7F99BC;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="bank_accounts" target="transfers"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="note" value="PayLink · CS 5600 · Logical ER model&#10;USD only · Five base relations&#10;* At least one holder is guaranteed by open_account; no deferred SQL assertion.&#10;Solid relationships are FKs. Source ownership is checked by the transfer function." style="text;whiteSpace=wrap;html=0;align=left;fontSize=13;fontColor=#617A92;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="770" width="1130" height="100" /></mxCell></root></mxGraphModel></diagram></mxfile>