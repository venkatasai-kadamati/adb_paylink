# Copy to .env; never commit actual credentials. Local setup script generates these.
DATABASE_URL=postgresql://paylink_api:CHANGE_ME@127.0.0.1:54322/postgres
ADMIN_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:54322/postgres
JWT_SECRET=generate-a-random-secret-at-least-32-characters
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000
# Optional hosted Supabase direct or session-pooler URL replaces DATABASE_URL.
# The Next.js frontend never receives database credentials or a service-role key.
# Enable only for the deliberately public synthetic Sai/Siddhardth profiles.
PUBLIC_DEMO_ENABLED=false
